# BeliX Bot Environment Variables

# Discord Bot Token (required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Guild ID
GUILD_ID=your_guild_id_here

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Channel IDs (used throughout the bot)
# Introduction/Welcome channel
introduction=your_channel_id_here

# Announcements channel
announcements=your_channel_id_here

# Common Hall channel
common-hall=your_channel_id_here

# Tinkering channel
tinkering=your_channel_id_here

# Vibe Coding channel
vibe-coding=your_channel_id_here

# Chamber of Cheers channel
chamber-of-cheers=your_channel_id_here

# Meeting Voice Channel
voiceroom-Common-hall=your_channel_id_here

# Meeting Tracker Configuration
MEETING_VOICE_CHANNEL_ID=your_voice_channel_id_here
MEETING_TEXT_CHANNEL_ID=your_text_channel_id_here
MEETING_PROMPT_HOUR=18
MEETING_PROMPT_MINUTE=30
MEETING_END_IDLE_MINUTES=5

# AI Voice Meeting Assistant Configuration
# Groq API Key: Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Groq Whisper Speech-to-Text model (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3

# Initial voice assistant mode: wake-word or active-meeting (default: wake-word)
VOICE_MODE=wake-word
